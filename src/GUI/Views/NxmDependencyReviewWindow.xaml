<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.NxmDependencyReviewWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Width="760" Height="600" MinWidth="620" MinHeight="440" MaxHeight="780"
	FontFamily="{DynamicResource Redux.FontFamily.UI}" FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}" ResizeMode="CanResize" ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}" Background="{DynamicResource ReduxWindowBrush}"
	Foreground="{DynamicResource ReduxTextPrimaryBrush}"
	UseLayoutRounding="True" SnapsToDevicePixels="True">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		</ResourceDictionary>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Warning}" />
		<Border Grid.Row="1" Padding="18,14" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel>
					<TextBlock x:Name="HeadingText" FontSize="{DynamicResource Redux.FontSize.20}"
						FontWeight="{DynamicResource Redux.FontWeight.Title}" Foreground="{DynamicResource ReduxTextPrimaryBrush}" />
					<TextBlock x:Name="DescriptionText" Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" />
				</StackPanel>
				<Border Grid.Row="1" Margin="0,12,0,9" Padding="12,9" Background="{DynamicResource ReduxWarningPillBackground}"
					BorderBrush="{DynamicResource ReduxWarningBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<TextBlock x:Name="SummaryText" Foreground="{DynamicResource ReduxTextPrimaryBrush}" TextWrapping="Wrap" />
				</Border>
				<ListBox x:Name="DependencyList" Grid.Row="2" Background="Transparent" BorderThickness="0"
					HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
					VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,7" Padding="12" Background="{DynamicResource ReduxSurfaceBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<Grid>
					<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
									<TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
									<TextBlock Grid.Row="1" Margin="0,4,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding Status}" TextWrapping="Wrap" />
									<TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding SourceHint}" TextWrapping="Wrap" />
									<StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Top">
										<Button MinWidth="76" Margin="0,0,7,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Content="Copy UUID"
											Visibility="{Binding CanCopyUuid, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CopyUuid_Click" />
										<Button MinWidth="76" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Content="Nexus Files"
											Visibility="{Binding CanOpenFiles, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OpenFiles_Click" />
									</StackPanel>
									<ItemsControl Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" ItemsSource="{Binding Downloads}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Button Margin="0,0,0,5" HorizontalAlignment="Left" Style="{StaticResource ReduxSecondaryActionButtonStyle}"
													Content="{Binding Label}" ToolTip="{Binding Explanation}" Tag="{Binding Download}" Click="ShowDownload_Click" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<Grid Grid.Row="3" Margin="0,10,0,0">
					<Button HorizontalAlignment="Right" MinWidth="90" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Content="Close" Click="Close_Click" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
