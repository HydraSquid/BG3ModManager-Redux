<UserControl x:Class="DivinityModManager.Views.NxmDownloadsPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	Foreground="{DynamicResource ReduxTextPrimaryBrush}"
	AllowDrop="True"
	PreviewDrop="Pane_PreviewDrop">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<CollectionViewSource x:Key="PendingDownloadsView" Source="{Binding NxmDownloads}" Filter="PendingDownloads_Filter" />
			<CollectionViewSource x:Key="InstalledDownloadsView" Source="{Binding NxmDownloads}" Filter="InstalledDownloads_Filter" />
			<Style TargetType="{x:Type controls:ReduxIcon}" BasedOn="{StaticResource ReduxOptionalInterfaceIconStyle}">
				<Setter Property="Width" Value="13" /><Setter Property="Height" Value="13" />
				<Setter Property="Margin" Value="0,0,5,0" />
				<Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
			</Style>
			<Style x:Key="DownloadSuccessActionButton" BasedOn="{StaticResource ReduxMinorSuccessActionButtonStyle}" TargetType="Button">
				<Setter Property="Margin" Value="0,0,6,6" /><Setter Property="Padding" Value="8,4" />
			</Style>
			<Style x:Key="DownloadWarningActionButton" BasedOn="{StaticResource ReduxMinorWarningActionButtonStyle}" TargetType="Button">
				<Setter Property="Margin" Value="0,0,6,6" /><Setter Property="Padding" Value="8,4" />
			</Style>
			<Style x:Key="DownloadDestructiveActionButton" BasedOn="{StaticResource ReduxMinorDestructiveActionButtonStyle}" TargetType="Button">
				<Setter Property="Margin" Value="0,0,6,6" /><Setter Property="Padding" Value="8,4" />
			</Style>
			<Style x:Key="DownloadNexusActionButton" BasedOn="{StaticResource ReduxMinorNexusActionButtonStyle}" TargetType="Button">
				<Setter Property="Margin" Value="0,0,6,6" /><Setter Property="Padding" Value="8,4" />
			</Style>
			<Style x:Key="DownloadActionButton" BasedOn="{StaticResource ReduxMinorActionButtonStyle}" TargetType="{x:Type Button}">
				<Setter Property="Margin" Value="0,0,6,6" />
				<Setter Property="Padding" Value="8,4" />
				<Setter Property="MinWidth" Value="0" />
			</Style>
			<Style x:Key="DownloadRowActionButton" BasedOn="{StaticResource DownloadActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Margin" Value="6,0,0,4" />
			</Style>
			<Style x:Key="PauseDownloadButton" BasedOn="{StaticResource DownloadWarningActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Margin" Value="6,0,0,4" />
				<Setter Property="Visibility" Value="Collapsed" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Resolving"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Queued"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Downloading"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="RetryWaiting"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ResumeDownloadButton" BasedOn="{StaticResource DownloadSuccessActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Margin" Value="6,0,0,4" />
				<Setter Property="Visibility" Value="Collapsed" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Paused"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="ReviewDownloadButton" BasedOn="{StaticResource DownloadSuccessActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Margin" Value="6,0,0,4" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
				<Setter Property="Visibility" Value="Collapsed" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="NeedsReview"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Downloaded"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="InstallFailed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding State}" Value="Installed" /><Condition Binding="{Binding HasAvailableArchive}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="DependenciesDownloadButton" BasedOn="{StaticResource DownloadRowActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Visibility" Value="Collapsed" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Downloaded"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="NeedsReview"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="InstallFailed"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
				</Style.Triggers>
			</Style>
			<Style x:Key="NexusDownloadButton" BasedOn="{StaticResource DownloadNexusActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Margin" Value="6,0,0,4" />
				<Style.Triggers><DataTrigger Binding="{Binding HasNexusSource}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
			</Style>
			<Style x:Key="RemoveDownloadButton" BasedOn="{StaticResource DownloadDestructiveActionButton}" TargetType="{x:Type Button}">
				<Setter Property="Margin" Value="6,0,0,4" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
				<Style.Triggers><DataTrigger Binding="{Binding State}" Value="Installing"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
			</Style>
			<Style x:Key="DownloadListItemStyle" TargetType="{x:Type ListBoxItem}">
				<Setter Property="Margin" Value="0,0,0,5" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Border x:Name="RowChrome" MinHeight="80" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<ContentPresenter Margin="{TemplateBinding Padding}" />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" /></Trigger>
								<Trigger Property="IsSelected" Value="True"><Setter TargetName="RowChrome" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" /><Setter TargetName="RowChrome" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" /></Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<DataTemplate x:Key="DownloadItemTemplate">
				<Border Padding="10,8"><Grid x:Name="DownloadRow"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
					<Border Width="52" Height="52" VerticalAlignment="Center" Background="{DynamicResource ReduxSurfaceMutedBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}"><Grid><controls:ReduxIcon Width="20" Height="20" Foreground="{DynamicResource ReduxTextMutedBrush}" StrokeData="{StaticResource Redux.Icon.Package}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" /><Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" /></Grid></Border>
					<StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource ReduxInfoBrush}" Text="{Binding StatusText}" /></Grid><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding FileDisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextMutedBrush}" Text="{Binding MetadataText}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding DownloadDetailText}" TextTrimming="CharacterEllipsis" Visibility="{Binding DownloadDetailText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" /><ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,7,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" Foreground="{DynamicResource ReduxInfoBrush}" Background="{DynamicResource ReduxSurfaceMutedBrush}" BorderThickness="0" Visibility="Collapsed" /></StackPanel>
					<WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" MaxWidth="{Binding ActualWidth, ElementName=DownloadRow}" VerticalAlignment="Center">
						<Button Tag="{Binding}" Style="{StaticResource PauseDownloadButton}" Click="PauseButton_Click" ToolTip="Pause download"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.StopCircle}" /><TextBlock Text="Pause" /></StackPanel></Button>
						<Button Tag="{Binding}" Style="{StaticResource ResumeDownloadButton}" Click="ResumeButton_Click" ToolTip="Resume or retry download"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.ArrowForwardStroke}" /><TextBlock Text="Resume" /></StackPanel></Button>
						<Button Tag="{Binding}" Style="{StaticResource ReviewDownloadButton}" Click="ReviewButton_Click" ToolTip="{Binding InstallActionText}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Package}" /><TextBlock Text="{Binding InstallActionText}" /></StackPanel></Button>
						<Button Tag="{Binding}" Style="{StaticResource DependenciesDownloadButton}" Click="DependenciesButton_Click" ToolTip="Review package dependencies"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.ListStroke}" /><TextBlock Text="Dependencies" /></StackPanel></Button>
						<Button Tag="{Binding}" Style="{StaticResource NexusDownloadButton}" Click="NexusButton_Click" ToolTip="{Binding NexusActionToolTip}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Open}" /><TextBlock Text="{Binding NexusActionText}" /></StackPanel></Button>
						<Button Tag="{Binding}" Style="{StaticResource RemoveDownloadButton}" Click="RemoveButton_Click" ToolTip="Remove this queue entry; installed mods are kept"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Trash}" /><TextBlock Text="{Binding RemoveActionText}" /></StackPanel></Button>
					</WrapPanel>
				</Grid></Border>
				<DataTemplate.Triggers>
					<DataTrigger Binding="{Binding State}" Value="Resolving"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /><Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="True" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Queued"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /><Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="True" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Downloading"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /></DataTrigger>
					<DataTrigger Binding="{Binding State}" Value="Installing"><Setter TargetName="DownloadProgress" Property="Visibility" Value="Visible" /><Setter TargetName="DownloadProgress" Property="IsIndeterminate" Value="True" /></DataTrigger>
				</DataTemplate.Triggers>
			</DataTemplate>
			<DataTemplate x:Key="RetainedArchiveItemTemplate">
				<Border Padding="10,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ReduxTextPrimaryBrush}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource ReduxSuccessBrush}" Text="{Binding DestinationText}" /><TextBlock Margin="0,2,0,0" FontSize="{DynamicResource Redux.FontSize.10}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding OriginalFileName}" TextTrimming="CharacterEllipsis" /></StackPanel>
					<WrapPanel Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
						<Button Tag="{Binding}" Style="{StaticResource DownloadSuccessActionButton}" Click="ReinstallArchiveButton_Click" ToolTip="Reinstall this retained package"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Package}" /><TextBlock Text="Reinstall" /></StackPanel></Button>
						<Button Tag="{Binding}" Style="{StaticResource DownloadNexusActionButton}" Click="ArchiveNexusButton_Click" ToolTip="Open on Nexus Mods" Visibility="{Binding HasNexusSource, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Open}" /><TextBlock Text="Open Nexus" /></StackPanel></Button>
					</WrapPanel>
				</Grid></Border>
			</DataTemplate>
		</ResourceDictionary>
	</UserControl.Resources>
	<Border Margin="5,4,10,10" Background="{DynamicResource ReduxListInteriorBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Card}">
		<Grid>
			<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
			<Border Background="{DynamicResource ReduxSurfaceElevatedBrush}" CornerRadius="{DynamicResource Redux.CornerRadius.Card}" IsHitTestVisible="False" />
			<Grid Height="{DynamicResource Redux.PaneHeaderHeight}" Margin="12,0">
				<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
				<TextBlock x:Name="DownloadsTitle" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource Redux.FontSize.14}" FontWeight="{DynamicResource Redux.FontWeight.Title}" Text="Downloads"
					ToolTip="NXM and local packages stay here until you review or install them." />
				<Button x:Name="CollapseDownloadsButton" Style="{StaticResource ReduxChromeButtonStyle}" Click="CloseButton_Click"
					AutomationProperties.Name="Collapse Downloads pane" ToolTip="Collapse Downloads pane">
					<Path Width="5" Height="10" Stretch="Fill" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
						Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Data="{StaticResource Redux.Icon.ChevronRightStroke}" />
				</Button>
			</Grid>
			<Border Grid.Row="1" Background="{DynamicResource ReduxBorderBrush}" />
			<WrapPanel Grid.Row="2" Margin="12,9,6,3">
				<CheckBox x:Name="SelectAllDownloadsCheckBox" Margin="0,4,10,10" VerticalAlignment="Center" Content="Select all" IsThreeState="True" Click="SelectAllDownloads_Click" Style="{StaticResource ReduxCheckBoxStyle}" />
				<Button Style="{StaticResource DownloadSuccessActionButton}" Click="InstallSelectedButton_Click" ToolTip="Install selected packages"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Package}" /><TextBlock Text="Install Selected" /></StackPanel></Button>
				<Button Style="{StaticResource DownloadSuccessActionButton}" Click="InstallAllButton_Click" ToolTip="Review and install all ready packages"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Package}" /><TextBlock Text="Install All" /></StackPanel></Button>
				<Button Style="{StaticResource DownloadActionButton}" Click="AddPackageButton_Click" ToolTip="Add a local package"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.AddStroke}" /><TextBlock Text="Add Package" /></StackPanel></Button>
				<Button Style="{StaticResource DownloadNexusActionButton}" Click="PasteLinkButton_Click" ToolTip="Add the NXM link from the clipboard"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.LinkStroke}" /><TextBlock Text="Paste NXM Link" /></StackPanel></Button>
				<Button Style="{StaticResource DownloadWarningActionButton}" Click="PauseAllButton_Click" ToolTip="Pause all downloads"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.StopCircle}" /><TextBlock Text="Pause All" /></StackPanel></Button>
				<Button Style="{StaticResource DownloadSuccessActionButton}" Click="ResumeAllButton_Click" ToolTip="Resume all downloads"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.ArrowForwardStroke}" /><TextBlock Text="Resume All" /></StackPanel></Button>
				<Button Style="{StaticResource DownloadDestructiveActionButton}" Click="RemoveSelectedButton_Click" ToolTip="Remove selected queue entries"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Trash}" /><TextBlock Text="Remove Selected" /></StackPanel></Button>
			</WrapPanel>
			<TabControl x:Name="DownloadsTabs" Grid.Row="3" Margin="12,0,12,8" SelectionChanged="DownloadsTabs_SelectionChanged" ItemContainerStyle="{StaticResource ReduxContentTabItemStyle}" Style="{StaticResource ReduxContentTabControlStyle}">
				<TabItem Header="Inbox"><Grid Margin="0,7,0,0"><Border Background="{DynamicResource ReduxAppBackgroundBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" /><ListBox x:Name="InboxDownloadsList" Margin="7" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Source={StaticResource PendingDownloadsView}}" SelectionMode="Extended" SelectionChanged="DownloadsList_SelectionChanged" ItemContainerStyle="{StaticResource DownloadListItemStyle}" ItemTemplate="{StaticResource DownloadItemTemplate}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" /><TextBlock x:Name="InboxEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="No packages need attention.&#x0a;Drop a package here, add a local file, or use Mod Manager Download on Nexus Mods." /></Grid></TabItem>
				<TabItem Header="History"><Grid Margin="0,7,0,0"><Border Background="{DynamicResource ReduxAppBackgroundBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" /><ListBox x:Name="HistoryDownloadsList" Margin="7" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Source={StaticResource InstalledDownloadsView}}" SelectionMode="Extended" SelectionChanged="DownloadsList_SelectionChanged" ItemContainerStyle="{StaticResource DownloadListItemStyle}" ItemTemplate="{StaticResource DownloadItemTemplate}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" /><TextBlock x:Name="HistoryEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="Installed downloads will appear here.&#x0a;Clearing history never uninstalls content." /></Grid></TabItem>
				<TabItem Header="Archives"><Grid Margin="0,7,0,0"><Border Background="{DynamicResource ReduxAppBackgroundBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Redux.CornerRadius.Control}" /><ListBox x:Name="ArchivesList" Margin="7" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding RetainedPackageArchives}" ItemContainerStyle="{StaticResource DownloadListItemStyle}" ItemTemplate="{StaticResource RetainedArchiveItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" /><TextBlock x:Name="ArchivesEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="No install packages are retained.&#x0a;Archive retention is optional and can be enabled in Preferences." /></Grid></TabItem>
			</TabControl>
			<WrapPanel Grid.Row="4" Margin="12,0,6,8">
				<Button Style="{StaticResource DownloadActionButton}" Click="OpenFolderButton_Click"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.FolderOpen}" /><TextBlock x:Name="OpenFolderText" Text="Open Folder" /></StackPanel></Button>
				<Button x:Name="AssociationButton" Style="{StaticResource DownloadActionButton}" Click="AssociationButton_Click"><StackPanel Orientation="Horizontal"><controls:ReduxIcon x:Name="AssociationIcon" StrokeData="{StaticResource Redux.Icon.LinkStroke}" /><TextBlock x:Name="AssociationText" Text="NXM Links..." /></StackPanel></Button>
				<Button x:Name="ClearHistoryButton" Style="{StaticResource DownloadDestructiveActionButton}" Click="ClearHistoryButton_Click"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Trash}" /><TextBlock Text="Clear History" /></StackPanel></Button>
				<Button x:Name="ClearArchivesButton" Style="{StaticResource DownloadDestructiveActionButton}" Click="ClearArchivesButton_Click"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{StaticResource Redux.Icon.Trash}" /><TextBlock Text="Clear Archives" /></StackPanel></Button>
			</WrapPanel>
		</Grid>
	</Border>
</UserControl>
