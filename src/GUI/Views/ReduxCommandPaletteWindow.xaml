<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxCommandPaletteWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:local="clr-namespace:DivinityModManager.Views"
	xmlns:util="clr-namespace:DivinityModManager.Util"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Quick Access"
	Width="620" Height="530" MinWidth="520" MinHeight="420" MaxWidth="760" MaxHeight="760"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}"
	PreviewKeyDown="Window_PreviewKeyDown">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

			<Style x:Key="CommandPaletteItemStyle" TargetType="{x:Type ListBoxItem}">
				<Setter Property="Margin" Value="0,0,0,3" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type ListBoxItem}">
							<Border x:Name="ItemChrome"
								Background="Transparent"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
								RenderTransformOrigin="0.5,0.5"
								util:ReduxWindowBehavior.HoverLift="1">
								<Border.RenderTransform>
									<TranslateTransform Y="0" />
								</Border.RenderTransform>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Border x:Name="DefaultHoverSurface" Grid.ColumnSpan="3"
										CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
										IsHitTestVisible="False"
										Opacity="0">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<Setter Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding HasContextualInteractionStyle}" Value="True">
														<Setter Property="Background" Value="Transparent" />
													</DataTrigger>
													<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
														<Setter Property="Background" Value="Transparent" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
									</Border>
									<Border x:Name="DefaultSelectionSurface" Grid.ColumnSpan="3"
										CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
										IsHitTestVisible="False"
										Opacity="0">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<Setter Property="Background" Value="{DynamicResource ReduxSelectionBrush}" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding HasContextualInteractionStyle}" Value="True">
														<Setter Property="Background" Value="Transparent" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
									</Border>
									<Border x:Name="ContextualHoverSurface" Grid.ColumnSpan="3"
										CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
										IsHitTestVisible="False"
										Opacity="0">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<Setter Property="Background" Value="Transparent" />
												<Style.Triggers>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Success}" />
															<Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource ReduxSuccessPillBackground}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Warning}" />
															<Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Error}" />
															<Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource ReduxErrorPillBackground}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions><Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Nexus}" /><Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" /></MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource Redux.Pill.Nexus.Background}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding HasAccentColor}" Value="True" />
															<Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{Binding AccentColor, Converter={StaticResource StringToGradientBrushConverter}, ConverterParameter=28\,10}" />
													</MultiDataTrigger>
													<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
														<Setter Property="Background" Value="Transparent" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
									</Border>
									<Border x:Name="ContextualSelectionSurface" Grid.ColumnSpan="3"
										CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
										IsHitTestVisible="False"
										Opacity="0">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<Setter Property="Background" Value="Transparent" />
												<Style.Triggers>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Success}" />
															<Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource ReduxSuccessPillBackground}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Warning}" />
															<Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Error}" />
															<Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource ReduxErrorPillBackground}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions><Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Nexus}" /><Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" /></MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource Redux.Pill.Nexus.Background}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding HasAccentColor}" Value="True" />
															<Condition Binding="{Binding UsesContextualInteractionColors}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{Binding AccentColor, Converter={StaticResource StringToGradientBrushConverter}, ConverterParameter=42\,22}" />
													</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
									</Border>
									<Border Width="30" Height="30" Margin="11,8,10,8"
										CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
										Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}">
										<Border.Style>
											<Style TargetType="{x:Type Border}">
												<Setter Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
												<Style.Triggers>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Success}" />
															<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource ReduxSuccessPillBackground}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Warning}" />
															<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Background" Value="{DynamicResource ReduxWarningPillBackground}" />
													</MultiDataTrigger>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Error}" />
															<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
														</MultiDataTrigger.Conditions>
												<Setter Property="Background" Value="{DynamicResource ReduxErrorPillBackground}" />
											</MultiDataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions><Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Nexus}" /><Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" /></MultiDataTrigger.Conditions>
												<Setter Property="Background" Value="{DynamicResource Redux.Pill.Nexus.Background}" />
											</MultiDataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding HasAccentColor}" Value="True" />
													<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
												</MultiDataTrigger.Conditions>
												<Setter Property="Background" Value="{Binding AccentColor, Converter={StaticResource StringToSolidBrushConverter}, ConverterParameter=33}" />
											</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<controls:ReduxIcon Width="15" Height="15"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											IconKey="{Binding IconKey}">
											<controls:ReduxIcon.Style>
												<Style BasedOn="{StaticResource {x:Type controls:ReduxIcon}}" TargetType="{x:Type controls:ReduxIcon}">
													<Setter Property="Foreground" Value="{DynamicResource ReduxAccentBrush}" />
													<Style.Triggers>
												<MultiDataTrigger>
													<MultiDataTrigger.Conditions>
																<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Success}" />
																<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
															</MultiDataTrigger.Conditions>
															<Setter Property="Foreground" Value="{DynamicResource ReduxSuccessBrush}" />
														</MultiDataTrigger>
														<MultiDataTrigger>
															<MultiDataTrigger.Conditions>
																<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Warning}" />
																<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
															</MultiDataTrigger.Conditions>
															<Setter Property="Foreground" Value="{DynamicResource ReduxWarningBrush}" />
														</MultiDataTrigger>
												<MultiDataTrigger>
													<MultiDataTrigger.Conditions>
														<Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Error}" />
																<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
															</MultiDataTrigger.Conditions>
											<Setter Property="Foreground" Value="{DynamicResource ReduxErrorBrush}" />
										</MultiDataTrigger>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions><Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Nexus}" /><Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" /></MultiDataTrigger.Conditions>
											<Setter Property="Foreground" Value="{DynamicResource Redux.Pill.Nexus.Border}" />
										</MultiDataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions>
													<Condition Binding="{Binding HasAccentColor}" Value="True" />
														<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
													</MultiDataTrigger.Conditions>
												<Setter Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource StringToSolidBrushConverter}}" />
											</MultiDataTrigger>
											<MultiDataTrigger>
												<MultiDataTrigger.Conditions><Condition Binding="{Binding Tone}" Value="{x:Static local:ReduxCommandPaletteTone.Nexus}" /><Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" /></MultiDataTrigger.Conditions>
												<Setter Property="Foreground" Value="{DynamicResource Redux.Pill.Nexus.Border}" />
											</MultiDataTrigger>
													</Style.Triggers>
												</Style>
											</controls:ReduxIcon.Style>
										</controls:ReduxIcon>
									</Border>
									<StackPanel Grid.Column="1" Margin="0,8,12,8" VerticalAlignment="Center">
									<TextBlock FontWeight="{DynamicResource Redux.FontWeight.Control}"
										Text="{Binding Name}"
										TextTrimming="CharacterEllipsis">
										<TextBlock.Style>
											<Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
												<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
												<Style.Triggers>
													<MultiDataTrigger>
														<MultiDataTrigger.Conditions>
															<Condition Binding="{Binding HasAccentColor}" Value="True" />
															<Condition Binding="{Binding Path=(dapp:DivinityApp.UseCategoryColorsForText)}" Value="True" />
														</MultiDataTrigger.Conditions>
														<Setter Property="Foreground" Value="{Binding AccentColor, Converter={StaticResource StringToSolidBrushConverter}}" />
													</MultiDataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
										<TextBlock Margin="0,2,0,0"
											Foreground="{DynamicResource ReduxTextMutedBrush}"
											Text="{Binding Category}"
											TextTrimming="CharacterEllipsis" />
									</StackPanel>
									<Border Grid.Column="2"
										Margin="0,8,11,8"
										Padding="7,3"
										VerticalAlignment="Center"
										Background="{DynamicResource ReduxSurfaceElevatedBrush}"
										BorderBrush="{DynamicResource ReduxBorderBrush}"
										BorderThickness="1"
										CornerRadius="{DynamicResource Redux.CornerRadius.Pill}"
										Visibility="{Binding HasGesture, Converter={StaticResource BoolToVisibilityConverter}}">
										<TextBlock Foreground="{DynamicResource ReduxTextSecondaryBrush}"
											FontSize="{DynamicResource Redux.FontSize.11}"
											Text="{Binding Gesture}" />
									</Border>
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="DefaultHoverSurface"
													Storyboard.TargetProperty="Opacity"
													To="1"
													Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
												<DoubleAnimation Storyboard.TargetName="ContextualHoverSurface"
													Storyboard.TargetProperty="Opacity"
													To="1"
													Duration="{StaticResource Redux.Motion.Fast}"
													EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetName="DefaultHoverSurface"
													Storyboard.TargetProperty="Opacity"
													To="0"
													Duration="{StaticResource Redux.Motion.Standard}" />
												<DoubleAnimation Storyboard.TargetName="ContextualHoverSurface"
													Storyboard.TargetProperty="Opacity"
													To="0"
													Duration="{StaticResource Redux.Motion.Standard}" />
											</Storyboard>
										</BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter TargetName="DefaultSelectionSurface" Property="Opacity" Value="1" />
									<Setter TargetName="ContextualSelectionSurface" Property="Opacity" Value="1" />
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="ItemChrome" Property="Opacity" Value="0.45" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.Flash}" />
		<Border Grid.Row="1"
			Padding="18"
			Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}"
			BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Border Padding="12,9"
					Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderStrongBrush}"
					BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<controls:ReduxIcon Width="16" Height="16"
							Margin="0,0,9,0"
							VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxTextMutedBrush}"
							Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
							StrokeData="{StaticResource Redux.Icon.Funnel}" />
						<TextBox x:Name="SearchBox"
							Grid.Column="1"
							Padding="0"
							Background="Transparent"
							BorderThickness="0"
							Foreground="{DynamicResource ReduxTextPrimaryBrush}"
							CaretBrush="{DynamicResource ReduxAccentBrush}"
							FontSize="{DynamicResource Redux.FontSize.14}"
							TextChanged="SearchBox_TextChanged"
							ToolTip="Find actions, mods, profiles, orders, or categories" />
					</Grid>
				</Border>

				<Border Grid.Row="1" Margin="0,12,0,10"
					Background="{DynamicResource ReduxSurfaceBrush}"
					BorderBrush="{DynamicResource ReduxBorderBrush}"
					BorderThickness="1"
					CornerRadius="{DynamicResource Redux.CornerRadius.Card}"
					ClipToBounds="True">
					<Grid>
						<ListBox x:Name="CommandList"
							Margin="5"
							Padding="0"
							Background="Transparent"
							BorderThickness="0"
							HorizontalContentAlignment="Stretch"
							MouseDoubleClick="CommandList_MouseDoubleClick"
							ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							ScrollViewer.VerticalScrollBarVisibility="Auto">
							<ListBox.ItemContainerStyle>
								<Style BasedOn="{StaticResource CommandPaletteItemStyle}" TargetType="{x:Type ListBoxItem}">
									<Setter Property="IsEnabled" Value="{Binding CanExecute}" />
								</Style>
							</ListBox.ItemContainerStyle>
						</ListBox>
						<StackPanel x:Name="EmptyState"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsHitTestVisible="False"
							Visibility="Collapsed">
							<controls:ReduxIcon Width="25" Height="25"
								HorizontalAlignment="Center"
								Foreground="{DynamicResource ReduxTextMutedBrush}"
								Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
								StrokeData="{StaticResource Redux.Icon.Flash}" />
							<TextBlock Margin="0,8,0,0"
								Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								FontWeight="{DynamicResource Redux.FontWeight.Control}"
								Text="No matching results" />
						</StackPanel>
					</Grid>
				</Border>

				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="&#x2191;&#x2193; Navigate   Enter Open   Esc Close" />
					<TextBlock Grid.Column="1"
						VerticalAlignment="Center"
						Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="{Binding ElementName=CommandList, Path=Items.Count, StringFormat={}{0} results}" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
