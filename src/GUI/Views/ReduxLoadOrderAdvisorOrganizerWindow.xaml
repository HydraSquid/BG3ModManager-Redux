<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxLoadOrderAdvisorOrganizerWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	xmlns:util="clr-namespace:DivinityModManager.Util"
	Title="Organize Active Load Order"
	Width="760" Height="680" MinWidth="660" MinHeight="540" MaxWidth="980" MaxHeight="900"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
			ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<DataTemplate x:Key="MoveTemplate">
				<Border Margin="0,0,0,6" Padding="11,8"
					Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock Foreground="{DynamicResource ReduxTextPrimaryBrush}"
								FontWeight="{DynamicResource Redux.FontWeight.Control}"
								Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
							<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
								Text="{Binding Reason}" TextWrapping="Wrap" />
						</StackPanel>
						<TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxInfoBrush}"
							Text="{Binding PositionSummary}" />
						<Button Grid.Column="2" Margin="9,0,0,0" Padding="8,4"
							Click="IgnoreAdviceButton_Click" CommandParameter="{Binding IgnoreKey}"
							Content="Ignore" Style="{StaticResource ReduxSecondaryActionButtonStyle}"
							ToolTip="Ignore this specific placement recommendation"
							Visibility="{Binding CanIgnore, Converter={StaticResource BoolToVisibilityConverter}}" />
					</Grid>
				</Border>
			</DataTemplate>
			<DataTemplate x:Key="UnresolvedTemplate">
				<Border Margin="0,0,0,6" Padding="11,8"
					Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<StackPanel>
						<TextBlock Foreground="{DynamicResource ReduxWarningBrush}"
							FontWeight="{DynamicResource Redux.FontWeight.Control}"
							Text="{Binding Relationship}" />
						<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
							Text="{Binding Reason}" TextWrapping="Wrap" />
						</StackPanel>
						<Button Grid.Column="1" Margin="9,0,0,0" Padding="8,4" VerticalAlignment="Center"
							Click="IgnoreAdviceButton_Click" CommandParameter="{Binding IgnoreKey}"
							Content="Ignore" Style="{StaticResource ReduxSecondaryActionButtonStyle}"
							ToolTip="Accept this placement and stop recommending it" />
					</Grid>
				</Border>
			</DataTemplate>
			<DataTemplate x:Key="SeparatorTemplate">
				<Border Margin="0,0,0,6" Padding="11,8" Background="{DynamicResource ReduxSurfaceElevatedBrush}"
					CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
					<Grid>
						<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock Foreground="{DynamicResource ReduxAccentHoverBrush}"
								FontWeight="{DynamicResource Redux.FontWeight.Control}" Text="{Binding Name}" />
							<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextMutedBrush}"
								Text="{Binding PlacementSummary}" TextWrapping="Wrap" />
						</StackPanel>
						<TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
							Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="{Binding CountSummary}" />
					</Grid>
				</Border>
			</DataTemplate>
			<Style x:Key="OrganizerTabItemStyle" TargetType="{x:Type TabItem}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderBrush" Value="Transparent" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="ClipToBounds" Value="False" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextSecondaryBrush}" />
				<Setter Property="Padding" Value="{DynamicResource Redux.TabHeader.Padding}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabItem}">
							<Grid x:Name="HeaderHost" Margin="0,0,4,0" Background="Transparent"
								util:ReduxWindowBehavior.HoverLift="1" RenderTransformOrigin="0.5,0.5"
								TextElement.Foreground="{DynamicResource ReduxTextMutedBrush}">
								<Grid.RenderTransform><TranslateTransform Y="0" /></Grid.RenderTransform>
								<Grid.RowDefinitions>
									<RowDefinition Height="*" />
									<RowDefinition Height="2" />
								</Grid.RowDefinitions>
								<Border x:Name="TabHoverSurface" Grid.RowSpan="2"
									Margin="{DynamicResource Redux.TabHeader.HoverMargin}"
									Background="{DynamicResource ReduxAccentSoftBrush}"
									CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
									IsHitTestVisible="False" Opacity="0" />
								<ContentPresenter Margin="{TemplateBinding Padding}"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									ContentSource="Header" RecognizesAccessKey="True" />
								<Border x:Name="SelectionUnderline" Grid.Row="1" Margin="5,0"
									Background="{DynamicResource ReduxAccentBrush}" CornerRadius="1"
									Opacity="0" RenderTransformOrigin="0.5,0.5">
									<Border.RenderTransform><ScaleTransform ScaleX="0.4" /></Border.RenderTransform>
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
									<Trigger.EnterActions>
										<BeginStoryboard><Storyboard>
											<DoubleAnimation Storyboard.TargetName="TabHoverSurface" Storyboard.TargetProperty="Opacity"
												To="1" Duration="{StaticResource Redux.Motion.Fast}" EasingFunction="{StaticResource Redux.Motion.EaseOut}" />
										</Storyboard></BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard><Storyboard>
											<DoubleAnimation Storyboard.TargetName="TabHoverSurface" Storyboard.TargetProperty="Opacity"
												To="0" Duration="{StaticResource Redux.Motion.Standard}" />
										</Storyboard></BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
								<Trigger Property="IsSelected" Value="True">
									<Setter Property="Panel.ZIndex" Value="1" />
									<Setter TargetName="HeaderHost" Property="TextElement.Foreground" Value="{DynamicResource ReduxAccentHoverBrush}" />
									<Setter TargetName="HeaderHost" Property="TextElement.FontWeight" Value="SemiBold" />
									<Trigger.EnterActions>
										<BeginStoryboard><Storyboard>
											<DoubleAnimation Storyboard.TargetName="SelectionUnderline" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
											<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
												Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
												To="1" Duration="0:0:0.14">
												<DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
											</DoubleAnimation>
										</Storyboard></BeginStoryboard>
									</Trigger.EnterActions>
									<Trigger.ExitActions>
										<BeginStoryboard><Storyboard>
											<DoubleAnimation Storyboard.TargetName="SelectionUnderline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" />
											<DoubleAnimation Storyboard.TargetName="SelectionUnderline"
												Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
												To="0.4" Duration="0:0:0.10" />
										</Storyboard></BeginStoryboard>
									</Trigger.ExitActions>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
			<Style x:Key="OrganizerTabControlStyle" TargetType="{x:Type TabControl}">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type TabControl}">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="38" />
									<RowDefinition Height="1" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<TabPanel Margin="0,0,0,3" ClipToBounds="False" IsItemsHost="True" />
								<Border Grid.Row="1" Height="1" Background="{DynamicResource ReduxBorderBrush}" />
								<ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="2" Margin="0,10,0,0"
									ContentSource="SelectedContent" KeyboardNavigation.DirectionalNavigation="Contained"
									TextElement.Foreground="{DynamicResource ReduxTextPrimaryBrush}" />
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ReorderStroke}" />
		<Border Grid.Row="1" Padding="22,19" Background="{DynamicResource ReduxAppBackgroundBrush}"
			BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="1">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				<StackPanel>
					<TextBlock FontSize="{DynamicResource Redux.FontSize.20}"
						FontWeight="{DynamicResource Redux.FontWeight.Title}"
						Foreground="{DynamicResource ReduxTextPrimaryBrush}"
						Text="Organize active load order" />
					<TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"
						Text="Preview conservative changes from the Load Order Advisor. Nothing is saved or exported automatically."
						TextWrapping="Wrap" />
				</StackPanel>

				<StackPanel Grid.Row="1" Margin="0,17,0,0">
					<TextBlock Margin="2,0,0,5" Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="Separator behavior" />
					<ComboBox x:Name="PolicyComboBox" MinHeight="34" DisplayMemberPath="Name"
						SelectionChanged="PolicyComboBox_SelectionChanged" />
					<TextBlock x:Name="PolicyDescriptionText" Margin="2,7,0,0"
						Foreground="{DynamicResource ReduxTextSecondaryBrush}" TextWrapping="Wrap" />
				</StackPanel>

				<UniformGrid Grid.Row="2" Margin="0,14,0,13" Columns="3">
					<Border Style="{StaticResource ReduxDialogSummaryCardStyle}">
						<StackPanel>
							<TextBlock x:Name="MoveCountText" FontSize="{DynamicResource Redux.FontSize.20}"
								FontWeight="{DynamicResource Redux.FontWeight.Title}"
								Foreground="{DynamicResource ReduxInfoBrush}" Text="0" />
							<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Mods repositioned" />
						</StackPanel>
					</Border>
					<Border Style="{StaticResource ReduxDialogSummaryCardStyle}">
						<StackPanel>
							<TextBlock x:Name="SeparatorCountText" FontSize="{DynamicResource Redux.FontSize.20}"
								FontWeight="{DynamicResource Redux.FontWeight.Title}"
								Foreground="{DynamicResource ReduxAccentHoverBrush}" Text="0" />
							<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Resulting separators" />
						</StackPanel>
					</Border>
					<Border Margin="0" Style="{StaticResource ReduxDialogSummaryCardStyle}">
						<StackPanel>
							<TextBlock x:Name="UnresolvedCountText" FontSize="{DynamicResource Redux.FontSize.20}"
								FontWeight="{DynamicResource Redux.FontWeight.Title}"
								Foreground="{DynamicResource ReduxWarningBrush}" Text="0" />
							<TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Needs review" />
						</StackPanel>
					</Border>
				</UniformGrid>

				<TabControl x:Name="PreviewTabs" Grid.Row="3" ItemContainerStyle="{StaticResource OrganizerTabItemStyle}" Style="{StaticResource OrganizerTabControlStyle}">
					<TabItem Header="Proposed Moves">
						<Grid>
							<ListBox x:Name="MoveList" Padding="0" Background="Transparent" BorderThickness="0"
								HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource MoveTemplate}"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
							<TextBlock x:Name="NoMovesText" HorizontalAlignment="Center" VerticalAlignment="Center"
								Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="No mod positions need to change." />
						</Grid>
					</TabItem>
					<TabItem x:Name="ResultingSeparatorsTab" Header="Resulting Separators">
						<Grid>
							<ListBox x:Name="SeparatorList" Padding="0" Background="Transparent" BorderThickness="0"
								HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource SeparatorTemplate}"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
							<TextBlock x:Name="NoSeparatorsText" HorizontalAlignment="Center" VerticalAlignment="Center"
								Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="This preview contains no separators." />
						</Grid>
					</TabItem>
					<TabItem Header="Needs Review">
						<Grid>
							<ListBox x:Name="UnresolvedList" Padding="0" Background="Transparent" BorderThickness="0"
								HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource UnresolvedTemplate}"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
							<TextBlock x:Name="NoUnresolvedText" HorizontalAlignment="Center" VerticalAlignment="Center"
								Foreground="{DynamicResource ReduxTextSecondaryBrush}"
								Text="No preserved boundaries block known relationships." />
						</Grid>
					</TabItem>
				</TabControl>

				<Grid Grid.Row="4" Margin="0,15,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock VerticalAlignment="Center" Foreground="{DynamicResource ReduxTextMutedBrush}"
						Text="Applying creates one undoable, unsaved change." />
					<Button x:Name="RestoreIgnoredButton" Grid.Column="1" Margin="0,0,10,0"
						Content="Restore Ignored Advice" Click="RestoreIgnoredButton_Click"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}" />
					<Button Grid.Column="2" MinWidth="84" Margin="0,0,8,0" Content="Cancel" IsCancel="True"
						Style="{StaticResource ReduxSecondaryActionButtonStyle}" />
					<Button x:Name="ApplyButton" Grid.Column="3" MinWidth="116" Content="Apply Preview"
						Style="{StaticResource ReduxPrimaryActionButtonStyle}" Click="ApplyButton_Click" />
				</Grid>
			</Grid>
		</Border>
	</Grid>
</adonisUI:AdonisWindow>
