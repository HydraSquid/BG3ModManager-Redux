<adonisUI:AdonisWindow x:Class="DivinityModManager.Views.ReduxOnboardingWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisUI="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:controls="clr-namespace:DivinityModManager.Controls"
	xmlns:dapp="clr-namespace:DivinityModManager;assembly=DivinityModManagerCore"
	xmlns:data="clr-namespace:DivinityModManager.Models;assembly=DivinityModManagerCore"
	xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
	Title="Welcome Setup"
	Width="740"
	Height="720"
	MinWidth="640"
	MinHeight="480"
	MaxWidth="900"
	MaxHeight="780"
	SizeToContent="Manual"
	ResizeMode="CanResize"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner"
	WindowStyle="SingleBorderWindow"
	Template="{DynamicResource ReduxWindowTemplate}"
	Background="{DynamicResource ReduxWindowBrush}"
	FontFamily="{DynamicResource Redux.FontFamily.UI}"
	FontSize="{DynamicResource Redux.FontSize.12}"
	FontWeight="{DynamicResource Redux.FontWeight.Body}"
	TextOptions.TextFormattingMode="Ideal"
	TextOptions.TextRenderingMode="ClearType">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome
			CaptionHeight="0"
			CornerRadius="0"
			GlassFrameThickness="0"
			ResizeBorderThickness="6"
			UseAeroCaptionButtons="False" />
	</shell:WindowChrome.WindowChrome>

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/MainResourceDictionary.xaml" />
			</ResourceDictionary.MergedDictionaries>

<Style x:Key="WelcomeDetailsStyle" TargetType="Expander">
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
<ToggleButton FocusVisualStyle="{StaticResource ReduxManagerKeyboardFocusStyle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" Foreground="{DynamicResource ReduxTextSecondaryBrush}" HorizontalContentAlignment="Left" Cursor="Hand">
<ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Surface" Background="Transparent" Padding="4,7" CornerRadius="4"><StackPanel Orientation="Horizontal">
<controls:ReduxIcon x:Name="Arrow" StrokeData="{DynamicResource Redux.Icon.ChevronRightStroke}" Foreground="{DynamicResource ReduxAccentHoverBrush}" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
<ContentPresenter VerticalAlignment="Center"/>
</StackPanel></Border><ControlTemplate.Triggers>
<Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="StrokeData" Value="{DynamicResource Redux.Icon.ChevronDownStroke}"/></Trigger>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ReduxHoverBrush}"/></Trigger>

</ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
</ToggleButton>
<Border x:Name="Details" Height="0" ClipToBounds="True" Visibility="Collapsed"><ContentPresenter/></Border>
</StackPanel></ControlTemplate></Setter.Value></Setter>
</Style>

			<Style x:Key="WelcomeSectionStyle" TargetType="Border">
				<Setter Property="Padding" Value="14,12" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="{DynamicResource Redux.CornerRadius.Card}" />
			</Style>
			<Style x:Key="WelcomeSectionTitleStyle" TargetType="TextBlock">
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.14}" />
				<Setter Property="FontWeight" Value="{DynamicResource Redux.FontWeight.Title}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
			</Style>
			<Style x:Key="WelcomeChoiceTitleStyle" TargetType="TextBlock">
				<Setter Property="FontWeight" Value="{DynamicResource Redux.FontWeight.Control}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextPrimaryBrush}" />
				<Setter Property="TextWrapping" Value="Wrap" />
			</Style>
			<Style x:Key="WelcomeChoiceDescriptionStyle" TargetType="TextBlock">
				<Setter Property="Margin" Value="0,3,0,0" />
				<Setter Property="FontSize" Value="{DynamicResource Redux.FontSize.10}" />
				<Setter Property="Foreground" Value="{DynamicResource ReduxTextMutedBrush}" />
				<Setter Property="TextWrapping" Value="Wrap" />
			</Style>
			<Style x:Key="WelcomeFeatureCardStyle" TargetType="Border">
				<Setter Property="Padding" Value="10" />
				<Setter Property="Background" Value="{DynamicResource ReduxSurfaceElevatedBrush}" />
				<Setter Property="BorderBrush" Value="{DynamicResource ReduxBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="{DynamicResource Redux.CornerRadius.Control}" />
			</Style>
			<Style x:Key="WelcomeThemeCardStyle" TargetType="RadioButton">
				<Setter Property="Margin" Value="0,0,8,0" />
				<Setter Property="Cursor" Value="Hand" />
				<Setter Property="FocusVisualStyle" Value="{x:Null}" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="RadioButton">
							<Border x:Name="Card"
								Padding="10"
								Background="{DynamicResource ReduxSurfaceElevatedBrush}"
								BorderBrush="{DynamicResource ReduxBorderBrush}"
								BorderThickness="1"
								CornerRadius="{DynamicResource Redux.CornerRadius.Control}">
								<ContentPresenter />
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="Card" Property="Background" Value="{DynamicResource ReduxHoverBrush}" />
									<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ReduxAccentHoverBrush}" />
								</Trigger>
								<Trigger Property="IsChecked" Value="True">
									<Setter TargetName="Card" Property="Background" Value="{DynamicResource ReduxAccentSoftBrush}" />
									<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
									<Setter TargetName="Card" Property="BorderThickness" Value="2" />
								</Trigger>
								<Trigger Property="IsKeyboardFocused" Value="True">
									<Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ReduxAccentBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>

 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <controls:ReduxWindowTitleBar IconData="{DynamicResource Redux.Icon.ReduxStar}" ShowWindowControls="False"/>
  <Border Grid.Row="1" Padding="18,14" Background="{DynamicResource ReduxAppBackgroundBrush}" BorderBrush="{DynamicResource ReduxBorderBrush}" BorderThickness="0,1,0,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Button x:Name="SetupStepButton" Tag="0" Click="StepButton_Click" HorizontalContentAlignment="Left" Margin="0,0,8,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Content="1  Your setup"/>
<Button x:Name="SourcesStepButton" Grid.Column="1" Tag="1" Click="StepButton_Click" HorizontalContentAlignment="Left" Margin="0,0,8,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Content="2  Add mods"/>
<Button x:Name="ManagersStepButton" Grid.Column="2" Tag="2" Click="StepButton_Click" Margin="0,0,8,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Content="3  Saves &amp; DLLs"/>
<Button x:Name="OrderStepButton" Grid.Column="3" Tag="3" Click="StepButton_Click" HorizontalContentAlignment="Left" Style="{StaticResource ReduxSecondaryActionButtonStyle}" Content="4  Load order"/>
</Grid>
<TextBlock x:Name="StepProgressText" Visibility="Collapsed" Text="Step 1 of 3"/>

     <TextBlock FontSize="22" x:Name="StepTitleText" Text="Make Redux comfortable" Margin="0,4,0,0" Style="{StaticResource ReduxWindowHeadingStyle}"/>
     <TextBlock x:Name="StepDescriptionText" Text="Choose your theme and accessibility settings." Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="OnboardingContentScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
     <Grid>
      <StackPanel x:Name="AppearancePage">
<Border Style="{StaticResource WelcomeSectionStyle}" Margin="0,0,0,12"><StackPanel>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel><TextBlock Text="Baldur’s Gate 3" Style="{StaticResource WelcomeSectionTitleStyle}"/><TextBlock x:Name="GameStatusText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/></StackPanel>
 <Button Grid.Column="1" Margin="12,0,0,0" Click="ChooseGame_Click" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon StrokeData="{DynamicResource Redux.Icon.FolderOpen}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Locate game…"/></StackPanel></Button></Grid>
 <TextBlock x:Name="GamePathText" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ReduxTextMutedBrush}"/>
 <TextBlock Margin="0,9,0,0" Text="Already have mods? Redux reads your existing mods and load order. Setup does not install mods or change your game’s order." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
</StackPanel></Border>
<Border Margin="0,0,0,10" Style="{StaticResource WelcomeSectionStyle}">
							<StackPanel>
								<TextBlock Style="{StaticResource WelcomeSectionTitleStyle}" Text="Choose a theme" />
								<TextBlock Margin="0,3,0,0"
									Foreground="{DynamicResource ReduxTextMutedBrush}"
									Text="Create your own custom themes later in Preferences."
									TextWrapping="Wrap" />
								<UniformGrid Margin="0,8,0,0" Columns="3">
									<RadioButton x:Name="ReduxDarkThemeCard" AutomationProperties.Name="Redux Dark theme"
										GroupName="WelcomeThemes"
										Style="{StaticResource WelcomeThemeCardStyle}"
										Tag="{x:Static data:ReduxThemeType.ReduxDark}"
										Click="ThemeCard_Click">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<Border Height="42" Margin="0,0,10,0" Background="#17121D" BorderBrush="#4B3A5C" BorderThickness="1" CornerRadius="5">
												<StackPanel Margin="7" VerticalAlignment="Center">
													<Border Height="7" Background="#33283F" CornerRadius="2" />
													<Border Width="26" Height="5" Margin="0,6,0,0" HorizontalAlignment="Left" Background="#9676FF" CornerRadius="2" />
												</StackPanel>
											</Border>
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Redux Dark" />
												<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Dark surfaces." />
											</StackPanel>
										</Grid>
									</RadioButton>
									<RadioButton x:Name="ReduxLightThemeCard" AutomationProperties.Name="Redux Light theme"
										GroupName="WelcomeThemes"
										Style="{StaticResource WelcomeThemeCardStyle}"
										Tag="{x:Static data:ReduxThemeType.ReduxLight}"
										Click="ThemeCard_Click">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<Border Height="42" Margin="0,0,10,0" Background="#F1EDF4" BorderBrush="#C5B9D1" BorderThickness="1" CornerRadius="5">
												<StackPanel Margin="7" VerticalAlignment="Center">
													<Border Height="7" Background="#DDD6E5" CornerRadius="2" />
													<Border Width="26" Height="5" Margin="0,6,0,0" HorizontalAlignment="Left" Background="#694AD6" CornerRadius="2" />
												</StackPanel>
											</Border>
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Redux Light" />
												<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Clean and bright." />
											</StackPanel>
										</Grid>
									</RadioButton>
									<RadioButton x:Name="ParchmentThemeCard" AutomationProperties.Name="Parchment theme"
										GroupName="WelcomeThemes"
										Margin="0"
										Style="{StaticResource WelcomeThemeCardStyle}"
										Tag="{x:Static data:ReduxThemeType.Parchment}"
										Click="ThemeCard_Click">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<Border Height="42" Margin="0,0,10,0" Background="#EBDEC5" BorderBrush="#AD9876" BorderThickness="1" CornerRadius="5">
												<StackPanel Margin="7" VerticalAlignment="Center">
													<Border Height="7" Background="#D1C0A2" CornerRadius="2" />
													<Border Width="26" Height="5" Margin="0,6,0,0" HorizontalAlignment="Left" Background="#8B3034" CornerRadius="2" />
												</StackPanel>
											</Border>
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Parchment" />
												<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Warm and classic." />
											</StackPanel>
										</Grid>
									</RadioButton>
								</UniformGrid>
							</StackPanel>
						</Border> <Border Style="{StaticResource WelcomeSectionStyle}">
							<StackPanel>
								<TextBlock Style="{StaticResource WelcomeSectionTitleStyle}" Text="Accessibility" />
								<Grid Margin="0,9,0,0">
									<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
									<CheckBox x:Name="ReduceMotionCheckBox"
										Style="{StaticResource ReduxCheckBoxStyle}"
										Checked="AccessibilityCheckBox_Changed"
										Unchecked="AccessibilityCheckBox_Changed">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<controls:ReduxIcon Width="17" Height="17" Margin="0,1,9,0" Foreground="{DynamicResource ReduxAccentHoverBrush}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{DynamicResource Redux.Icon.Flash}" />
											<StackPanel Grid.Column="1">
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Reduce motion" />
												<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Turn off animated transitions." />
											</StackPanel>
										</Grid>
									</CheckBox>
									<CheckBox x:Name="DisableBackgroundEffectsCheckBox" Grid.Column="2"
										Style="{StaticResource ReduxCheckBoxStyle}"
										Checked="AccessibilityCheckBox_Changed"
										Unchecked="AccessibilityCheckBox_Changed">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<controls:ReduxIcon Width="17" Height="17" Margin="0,1,9,0" Foreground="{DynamicResource ReduxAccentHoverBrush}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{DynamicResource Redux.Icon.Eye}" />
											<StackPanel Grid.Column="1">
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Disable blur and dimming" />
												<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Keep the background clear behind windows." />
											</StackPanel>
										</Grid>
									</CheckBox>
								</Grid>
							</StackPanel>
						</Border></StackPanel>
      <StackPanel x:Name="ConnectionsPage" Visibility="Collapsed"><Border Style="{StaticResource WelcomeSectionStyle}" Margin="0,0,0,12"><StackPanel>
<TextBlock Text="Bring your first mod into Redux" Style="{StaticResource WelcomeSectionTitleStyle}"/>
<TextBlock Margin="0,8,0,0" Text="Local files · Choose Add Package in Download Manager, or drag in an archive or PAK. Review the package, then install it. No account connection is needed." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
<TextBlock Margin="0,8,0,0" Text="Nexus downloads · Connect below, then use Mod Manager Download on Nexus Mods. Downloads appear in the same manager; you choose when to install them." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
</StackPanel></Border><CheckBox x:Name="SourceIntegrationsCheckBox"
										Style="{StaticResource ReduxCheckBoxStyle}"
										Checked="SourceIntegrationsCheckBox_Changed"
										Unchecked="SourceIntegrationsCheckBox_Changed">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<controls:ReduxIcon Width="17" Height="17" Margin="0,1,9,0" Foreground="{DynamicResource ReduxInfoBrush}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{DynamicResource Redux.Icon.LinkStroke}" />
											<StackPanel Grid.Column="1">
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Source linking" />
												<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Link installed mods to Nexus Mods or mod.io for authors, versions, images, and update information." />
											</StackPanel>
										</Grid>
									</CheckBox> <Border x:Name="SourceCredentialsPanel"
									Margin="0,11,0,0"
									Padding="10"
									Background="{DynamicResource ReduxSurfaceElevatedBrush}"
									BorderBrush="{DynamicResource ReduxBorderBrush}"
									BorderThickness="1"
									CornerRadius="{DynamicResource Redux.CornerRadius.Control}"
									Visibility="Collapsed">
									<StackPanel>
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<controls:ReduxIcon Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource ReduxInfoBrush}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{DynamicResource Redux.Icon.Key}" />
											<StackPanel Grid.Column="1">
											<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Mod service keys" />
											<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Optional. Keys are stored on this computer and can be changed or removed later in Preferences." />
											</StackPanel>
										</Grid>
										<Grid Margin="24,9,0,0">
											<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<StackPanel>
												<StackPanel Margin="1,0,0,4" Orientation="Horizontal">
												<ContentControl Width="15" Height="15" Margin="0,0,6,0" ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" />
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Nexus Mods API key" />
											</StackPanel>
											<PasswordBox x:Name="NexusApiKeyTextBox" AutomationProperties.Name="Nexus Mods API key" MinHeight="34" ToolTip="Personal Nexus Mods API key used for mod information and update checks" />
											</StackPanel>
											<StackPanel Grid.Column="2">
												<StackPanel Margin="1,0,0,4" Orientation="Horizontal">
												<ContentControl Width="15" Height="15" Margin="0,0,6,0" ContentTemplate="{DynamicResource ModioPlatformIconTemplate}" />
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="mod.io API key" />
											</StackPanel>
											<PasswordBox x:Name="ModioApiKeyTextBox" AutomationProperties.Name="mod.io API key" MinHeight="34" ToolTip="Read-only mod.io API key used for mod information" />
											</StackPanel>
										</Grid>
										<CheckBox x:Name="NxmLinksCheckBox" Margin="24,11,0,0" Style="{StaticResource ReduxCheckBoxStyle}">
											<Grid>
												<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
												<ContentControl Width="16" Height="16" Margin="0,1,8,0" ContentTemplate="{DynamicResource NexusPlatformIconTemplate}" Visibility="{Binding Path=(dapp:DivinityApp.ShowInterfaceIcons), Converter={StaticResource BoolToVisibilityConverter}}" />
												<StackPanel Grid.Column="1">
													<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Open Nexus download links in Redux" />
													<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Send Mod Manager Download links to Redux for review and installation." />
												</StackPanel>
											</Grid>
										</CheckBox>
										<Grid Margin="24,10,0,0">
											<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<controls:ReduxIcon Width="15" Height="15" Margin="0,1,7,0"
												Foreground="{DynamicResource ReduxWarningBrush}"
												StrokeData="{DynamicResource Redux.Icon.Information}" />
											<TextBlock Grid.Column="1"
												FontSize="{DynamicResource Redux.FontSize.11}"
												Foreground="{DynamicResource ReduxTextMutedBrush}"
												Text="Nexus downloads require a Nexus Mods API key."
												TextWrapping="Wrap" />
										</Grid>
									</StackPanel>
								</Border></StackPanel>
      <StackPanel x:Name="ManagersPage" Visibility="Collapsed">
       <Border Style="{StaticResource WelcomeSectionStyle}" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="Drop it into Redux" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Drag mod packages, saves, or native DLL packages into the Redux window to start installing. Redux identifies supported files and opens the appropriate import or review flow."/>
       </StackPanel></Border>
       <Border Style="{StaticResource WelcomeSectionStyle}" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="Save Game Manager" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Open Manage in the Saves toolbar to browse the selected profile’s saves. Drop a save file, folder, or ZIP into the manager, or choose Install Save or Import Folder. Saves Folder opens their location on disk."/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Importing a save does not install the mods it requires. Check its mod requirements before playing."/>
       </StackPanel></Border>
       <Border Style="{StaticResource WelcomeSectionStyle}"><StackPanel>
        <TextBlock Text="Game-directory mods" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="Native DLL mods and Script Extender live in the game folder, outside the active load order. Use Game-Directory Mod Manager to review their files, install supported packages, and manage installations tracked by this Redux copy."/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}" Text="Install native code only from sources you trust. Redux may ask you to review replacements or missing backups before continuing."/>
       </StackPanel></Border>
      </StackPanel>
      <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
<Border Style="{StaticResource WelcomeSectionStyle}" Margin="0,0,0,12"><StackPanel>
 <TextBlock Text="Try a load order" Style="{StaticResource WelcomeSectionTitleStyle}"/>
 <TextBlock Text="Practice only · This example does not touch your mods or game." Margin="0,4,0,12" Foreground="{DynamicResource ReduxTextMutedBrush}" TextWrapping="Wrap"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource WelcomeFeatureCardStyle}"><StackPanel><TextBlock Text="Inactive Mods" Style="{StaticResource WelcomeChoiceTitleStyle}"/><TextBlock x:Name="DemoInactiveText" Text="Example mod" Margin="0,10,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/></StackPanel></Border>
 <Border Grid.Column="2" Style="{StaticResource WelcomeFeatureCardStyle}"><StackPanel><TextBlock Text="Active Mods" Style="{StaticResource WelcomeChoiceTitleStyle}"/><TextBlock x:Name="DemoActiveText" Text="No active mods" Margin="0,10,0,0" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/></StackPanel></Border></Grid>
 <TextBlock x:Name="DemoProgressText" Text="Installed → Activate → Save → Sync" Margin="0,12,0,0" Foreground="{DynamicResource ReduxAccentHoverBrush}" TextWrapping="Wrap"/>
<TextBlock x:Name="DemoInstructionText" Text="New mods start inactive. Activate the example mod to include it in your load order." Margin="0,12,0,10" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
 <Button x:Name="DemoActionButton" Click="DemoAction_Click" HorizontalAlignment="Left" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" StrokeData="{DynamicResource Redux.Icon.ChevronRightStroke}"/><TextBlock x:Name="DemoActionLabel" Text="Activate example mod"/></StackPanel></Button>
</StackPanel></Border>

       <Border Style="{StaticResource WelcomeSectionStyle}"><StackPanel><CheckBox x:Name="GuidanceCheckBox"

										Style="{StaticResource ReduxCheckBoxStyle}"
										Checked="GuidanceCheckBox_Changed"
										Unchecked="GuidanceCheckBox_Changed">
										<Grid>
											<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
											<controls:ReduxIcon Width="17" Height="17" Margin="0,1,9,0" Foreground="{DynamicResource ReduxWarningBrush}" Style="{StaticResource ReduxOptionalInterfaceIconStyle}" StrokeData="{DynamicResource Redux.Icon.Flag}" />
											<StackPanel Grid.Column="1">
												<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Load Order Advisor (experimental)" />
												<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}" Text="Review placement checks and ordering suggestions before applying them." />
											</StackPanel>
										</Grid>
									</CheckBox> <CheckBox x:Name="RetainArchivesCheckBox" Margin="0,12,0,0"
									Style="{StaticResource ReduxCheckBoxStyle}">
									<Grid>
										<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
										<controls:ReduxIcon Width="17" Height="17" Margin="0,1,9,0"
											Foreground="{DynamicResource ReduxAccentHoverBrush}"
											Style="{StaticResource ReduxOptionalInterfaceIconStyle}"
											StrokeData="{DynamicResource Redux.Icon.Archive}" />
										<StackPanel Grid.Column="1">
											<TextBlock Style="{StaticResource WelcomeChoiceTitleStyle}" Text="Keep installed package archives" />
											<TextBlock Style="{StaticResource WelcomeChoiceDescriptionStyle}"
												Text="Keep verified packages for reinstalling later. Off by default; uses additional disk space." />
										</StackPanel>
									</Grid>
								</CheckBox></StackPanel></Border>
<Expander x:Name="BeforePlayExpander" Expanded="BeforePlayExpansion_Changed" Collapsed="BeforePlayExpansion_Changed" Style="{StaticResource WelcomeDetailsStyle}" Header="Before you play" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0">
<TextBlock Text="Check each mod’s requirements. Dependencies must be installed too, and some mods need Script Extender or a specific position in the order." TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
<TextBlock Text="Review Mod Diagnostics, then sync your order to the game. Keep the same mod setup when returning to an existing save." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ReduxTextSecondaryBrush}"/>
</StackPanel></Expander>
<CheckBox x:Name="OpenDownloadsCheckBox" IsChecked="True" Margin="0,12,0,0" Style="{StaticResource ReduxCheckBoxStyle}" Content="Open Download Manager when I finish"/>
      </StackPanel>
     </Grid>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,16,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="NotNowButton" HorizontalAlignment="Left" Click="CloseButton_Click" IsCancel="True" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{DynamicResource Redux.Icon.Close}"/><TextBlock Text="Not now"/></StackPanel></Button>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="BackButton" Visibility="Collapsed" Click="BackButton_Click" Margin="0,0,8,0" Style="{StaticResource ReduxSecondaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><controls:ReduxIcon VerticalAlignment="Center" Width="14" Height="14" Margin="0,0,6,0" StrokeData="{DynamicResource Redux.Icon.ChevronLeftStroke}"/><TextBlock Text="Back"/></StackPanel></Button>
      <Button x:Name="SaveContinueButton" MinWidth="110" Click="SaveButton_Click" IsDefault="True" Style="{StaticResource ReduxPrimaryActionButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ContinueLabel" Text="Next"/><controls:ReduxIcon x:Name="ContinueIcon" VerticalAlignment="Center" Width="14" Height="14" Margin="6,0,0,0" StrokeData="{DynamicResource Redux.Icon.ChevronRightStroke}"/></StackPanel></Button>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</adonisUI:AdonisWindow>
