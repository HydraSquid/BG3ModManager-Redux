<Window x:Class="ReduxInstaller.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Redux Setup" Width="850" Height="650" MinWidth="760" MinHeight="580"
	WindowStartupLocation="CenterScreen" Icon="Resources/BG3ModManager.ico"
	Style="{StaticResource {x:Type Window}}"
	Loaded="Window_Loaded" Closing="Window_Closing">
	<Grid Margin="28,24,28,22">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Border Width="48" Height="48" Margin="0,0,16,0" Background="#2B1D3C"
				BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10">
				<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"
					Foreground="{StaticResource AccentBrush}" Text="✦" />
			</Border>
			<StackPanel Grid.Column="1" VerticalAlignment="Center">
				<TextBlock x:Name="HeadingText" FontSize="25" FontWeight="SemiBold"
					Text="BG3 Mod Manager Redux Setup" />
				<TextBlock x:Name="SubheadingText" Margin="0,5,0,0" FontSize="13.5"
					Foreground="{StaticResource MutedTextBrush}" Text="Preparing the public-alpha installation checks…" />
			</StackPanel>
		</Grid>

		<Grid Grid.Row="1" Margin="0,22,0,18">
			<Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
				BorderThickness="1" CornerRadius="10" />

			<StackPanel x:Name="LoadingPanel" Margin="22" VerticalAlignment="Center">
				<ProgressBar IsIndeterminate="True" />
				<TextBlock x:Name="LoadingStatusText" Margin="0,18,0,0" HorizontalAlignment="Center"
					FontSize="15" Text="Checking the official Redux release…" />
				<TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
					Text="Redux is downloaded only after you review the release and installation paths." />
			</StackPanel>

			<ScrollViewer x:Name="ReviewPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="22,20">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock FontSize="16" FontWeight="SemiBold" Text="Release" />
							<TextBlock x:Name="ReleaseSummaryText" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" />
						</StackPanel>
						<Button Grid.Column="1" Content="Release notes" Click="ReleaseNotes_Click" />
					</Grid>

					<Border Margin="0,16,0,0" Padding="14" Background="{StaticResource WindowBrush}"
						BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock FontWeight="SemiBold" Text=".NET 8 Desktop Runtime (x64)" />
								<TextBlock x:Name="RuntimeStatusText" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal">
								<Button x:Name="RuntimePageButton" Content="Microsoft page" Click="RuntimePage_Click" />
								<Button x:Name="InstallRuntimeButton" Style="{StaticResource PrimaryButton}"
									Content="Install .NET 8" Click="InstallRuntime_Click" />
							</StackPanel>
						</Grid>
					</Border>

					<TextBlock Margin="0,17,0,5" FontWeight="SemiBold" Text="Install Redux to" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox x:Name="InstallPathTextBox" VerticalContentAlignment="Center" />
						<Button Grid.Column="1" Content="Browse…" Click="BrowseInstallPath_Click" />
					</Grid>
					<TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
						Text="Use the recommended per-user location or choose another empty, writable folder outside the game." />

					<TextBlock Margin="0,15,0,5" FontWeight="SemiBold" Text="Baldur’s Gate 3 folder (optional)" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox x:Name="GamePathTextBox" VerticalContentAlignment="Center" />
						<Button Grid.Column="1" Content="Browse…" Click="BrowseGamePath_Click" />
					</Grid>
					<TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
						Text="Setup only validates and displays this path. Redux Welcome Setup can find it later if left blank." />

					<Border Margin="0,16,0,0" Padding="13" Background="{StaticResource WindowBrush}"
						BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="145" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock FontWeight="SemiBold" Text="Larian data" />
							<TextBlock x:Name="LarianPathText" Grid.Column="1" Foreground="{StaticResource MutedTextBrush}"
								TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="60000" />
							<TextBlock Grid.Row="1" Margin="0,7,0,0" FontWeight="SemiBold" Text="Mods folder" />
							<TextBlock x:Name="ModsPathText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0"
								Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
								ToolTipService.ShowDuration="60000" />
						</Grid>
					</Border>

					<CheckBox x:Name="DesktopShortcutCheckBox" Margin="0,17,0,0"
						Content="Create a desktop shortcut" />
				</StackPanel>
			</ScrollViewer>

			<StackPanel x:Name="ProgressPanel" Margin="22" Visibility="Collapsed" VerticalAlignment="Center">
				<ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="1" />
				<TextBlock x:Name="ProgressStatusText" Margin="0,18,0,0" HorizontalAlignment="Center"
					FontSize="15" Text="Preparing…" />
				<TextBlock x:Name="ProgressDetailText" Margin="0,8,0,0" HorizontalAlignment="Center"
					Foreground="{StaticResource MutedTextBrush}" Text="Downloads are verified before anything is installed." />
			</StackPanel>

			<StackPanel x:Name="CompletePanel" Margin="22" Visibility="Collapsed" VerticalAlignment="Center">
				<TextBlock HorizontalAlignment="Center" Foreground="{StaticResource SuccessBrush}" FontSize="40" Text="✓" />
				<TextBlock x:Name="CompleteHeadingText" Margin="0,12,0,0" HorizontalAlignment="Center"
					FontSize="20" FontWeight="SemiBold" Text="Redux is ready" />
				<TextBlock x:Name="CompleteDetailText" Margin="0,8,0,0" MaxWidth="620" HorizontalAlignment="Center"
					TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
			</StackPanel>

			<StackPanel x:Name="ErrorPanel" Margin="22" Visibility="Collapsed" VerticalAlignment="Center">
				<TextBlock HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}" FontSize="38" Text="!" />
				<TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="20"
					FontWeight="SemiBold" Text="Setup needs attention" />
				<TextBlock x:Name="ErrorText" Margin="0,9,0,0" MaxWidth="650" HorizontalAlignment="Center"
					TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
			</StackPanel>

			<StackPanel x:Name="UninstallPanel" Margin="22" Visibility="Collapsed" VerticalAlignment="Center">
				<TextBlock HorizontalAlignment="Center" Foreground="{StaticResource WarningBrush}" FontSize="38" Text="−" />
				<TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="20"
					FontWeight="SemiBold" Text="Uninstall Redux?" />
				<TextBlock x:Name="UninstallDetailText" Margin="0,9,0,0" MaxWidth="650" HorizontalAlignment="Center"
					TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
					Text="Setup removes only files listed in the installed Redux release. Your mods, saves, settings, downloads, archives, and other unlisted content stay in place." />
			</StackPanel>
		</Grid>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="FooterText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
				Text="No game files, mods, or saves will be changed." />
			<StackPanel Grid.Column="1" Orientation="Horizontal">
				<Button x:Name="SecondaryButton" Content="Cancel" Click="Secondary_Click" />
				<Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Content="Install Redux"
					Click="Primary_Click" IsDefault="True" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
