<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net48</TargetFramework>
		<UseWPF>true</UseWPF>
		<AssemblyName>BG3ModManager-Redux-Setup</AssemblyName>
		<RootNamespace>ReduxInstaller</RootNamespace>
		<AssemblyTitle>BG3 Mod Manager Redux Setup</AssemblyTitle>
		<Product>BG3 Mod Manager Redux Setup</Product>
		<Description>Standalone web installer for BG3 Mod Manager Redux</Description>
		<AssemblyVersion>0.1.0.15</AssemblyVersion>
		<FileVersion>0.1.0.15</FileVersion>
		<Version>0.1.0-alpha.15</Version>
		<InformationalVersion>0.1.0-alpha.15</InformationalVersion>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64</Platforms>
		<Configurations>Debug;Release</Configurations>
		<OutputPath>$(MSBuildProjectDirectory)\..\..\bin\InstallerPayload\$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<ApplicationIcon>..\GUI\Redux.ico</ApplicationIcon>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<DebugType Condition="'$(Configuration)' == 'Debug'">full</DebugType>
		<DebugType Condition="'$(Configuration)' != 'Debug'">none</DebugType>
		<Optimize Condition="'$(Configuration)' == 'Debug'">false</Optimize>
		<Optimize Condition="'$(Configuration)' != 'Debug'">true</Optimize>
		<AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" GeneratePathProperty="true" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="$(PkgNewtonsoft_Json)\lib\net45\Newtonsoft.Json.dll"
			LogicalName="ReduxInstaller.Dependencies.Newtonsoft.Json.dll" />
		<Resource Include="..\GUI\Redux.ico" Link="Resources\Redux.ico" />
		<Resource Include="..\GUI\Resources\Fonts\Manrope-Regular.ttf" Link="Resources\Fonts\Manrope-Regular.ttf" />
		<Resource Include="..\GUI\Resources\Fonts\Manrope-SemiBold.ttf" Link="Resources\Fonts\Manrope-SemiBold.ttf" />
		<EmbeddedResource Include="..\..\LICENSE" Link="Legal\LICENSE.txt" />
		<EmbeddedResource Include="..\..\licenses\Third-Party-Notices.md" Link="Legal\Third-Party-Notices.md" />
		<EmbeddedResource Include="..\..\licenses\NewtonsoftJson-MIT.txt" Link="Legal\NewtonsoftJson-MIT.txt" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="System.IO.Compression" />
		<Reference Include="System.IO.Compression.FileSystem" />
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="System.Net.Http" />
		<Reference Include="System.Windows.Forms" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Redux.Installer.Tests" />
	</ItemGroup>
	<Target Name="RemoveLooseInstallerDependencies" AfterTargets="Build">
		<Delete Files="$(OutputPath)Newtonsoft.Json.dll;$(OutputPath)Newtonsoft.Json.xml" />
	</Target>
</Project>
